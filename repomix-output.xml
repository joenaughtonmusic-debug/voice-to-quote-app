function detectedCadence(transcript: string) {
  if (/\bmonthly\b/i.test(transcript)) return "monthly"
  if (/\bweekly\b/i.test(transcript)) return "weekly"
  if (/\bfortnightly\b/i.test(transcript)) return "fortnightly"
