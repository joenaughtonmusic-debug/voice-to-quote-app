  unit_sell_price: number | null
  unit_price_source: "spoken_override" | "plant_library" | "missing"
  plant_total: number | null
  item_code?: string
  source_system?: string
  account_code?: string
  sales_account_code?: string
  tax_code?: string
  tax_type?: string
