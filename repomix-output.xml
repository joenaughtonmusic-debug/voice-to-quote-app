}

export type QuoteFactPlaceholder =
  | "{{customer_name}}"
  | "{{site_address}}"
  | "{{job_scope}}"
  | "{{labour_scope}}"
  | "{{materials_scope}}"
  | "{{waste_scope}}"
  | "{{plant_options}}"
  | "{{exclusions}}"
  | "{{terms}}"

type AddTextFactsOptions = {
