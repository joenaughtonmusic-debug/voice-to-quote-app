export type PlantCalculatorWarningCode =
  | "missing_quantity"
  | "missing_length"
  | "missing_spacing"
  | "invalid_quantity"
  | "invalid_length"
  | "invalid_spacing"
  | "missing_price"
  | "unresolved_plant"
  | "out_of_stock"

export type PlantCalculatorWarning = {
  code: PlantCalculatorWarningCode
  message: string
  field?: string
  severity: "info" | "warning"
}

export type PlantLibraryOption = {
  id?: string
  source_system?: string
  item_code?: string
  item_name?: string
  plant_name: string
  botanical_name?: string
  common_name?: string
